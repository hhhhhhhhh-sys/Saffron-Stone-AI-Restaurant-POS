MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=restaurant_db
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_root_password

# Dedicated SELECT-only account for the local MCP analytics service.
MYSQL_READONLY_USER=restaurant_mcp_reader
MYSQL_READONLY_PASSWORD=RestMcp@2026#92
MCP_SHARED_TOKEN=YOUR_GENERATED_RANDOM_TOKEN
MCP_SERVER_URL=http://127.0.0.1:8003/mcp
MCP_PORT=8003

# AI Business Assistant Configuration:
# Option 1: Unlimited Built-In Analytics Engine (Free forever, no credits or API keys needed)
# AI_PROVIDER=local
# AI_API_KEY=local
# AI_MODEL=local-analytics

# Option 2: OpenAI or external provider (Automatically falls back to local engine if credits expire)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=replace_with_your_provider_api_key
AI_MODEL=gpt-4o-mini

# Option 3: Free Google Gemini API (1,500 free requests/day with no credit card)
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AI_API_KEY=your_gemini_api_key_from_aistudio.google.com
# AI_MODEL=gemini-1.5-flash

# Required only when creating the initial accounts in a new database.
